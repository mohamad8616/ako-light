// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  /// Allowed values: "user" | "admin" | "owner"
  role                String    @default("user")
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  /// Optional referral/invitation code captured on the phone-entry step and
  /// stored on sign-up only (passed through phoneNumber.verify() — see
  /// user.additionalFields in lib/auth/auth.ts). Null for email sign-ups
  /// and for phone logins where no code was typed.
  referredByCode      String?
  /// Ban support required by better-auth's admin plugin.
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]
  orders              Order[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  /// Set when an owner/admin impersonates this session (admin plugin).
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Catalog / content domain
//
// Mirrors the static data under lib/data/* (which stays the live source for
// the site until reads are switched over to the database).
//
// Conventions (see AGENTS.md):
//   - `Localized` values ({ en, fa }) stay in ONE `Json` column (jsonb) so the
//     `Localized` type keeps working unchanged in the app.
//   - Ordered string[] / object[] content also lives in `Json` (order is part
//     of the content: paragraphs, gallery lists, downloads, related items).
//   - `id` identifies the row, `slug` is the human/route handle.
//   - Parent/child FKs reference the parent's `id` (not `slug`): slugs are
//     human/route handles and may change, so they must not be load-bearing for
//     relational integrity. Each FK column is named after the parent entity's
//     `id` (e.g. `Product.categoryId` → `ProductCategory.id`).
//     `slug` remains a `@unique` column used for URL routing / `getBySlug` lookups
//     but is never used as a foreign-key target.
//   - When an entity's slug changes, its old slug is recorded in `SlugHistory`
//     so that inbound links to the old URL can 301-redirect to the new slug.
// ---------------------------------------------------------------------------

/**
 * Material finish type. Mirrors the union in lib/data/materials.ts:
 * stone | metal | glass | wood | fabric | leather | marble | stone-composite.
 * `stone_composite` is `@map`ped so the database stores the exact
 * "stone-composite" string used by the source data; the Prisma client exposes
 * it as `MaterialType.stone_composite` (hyphens are not valid in Prisma enum
 * value names).
 */
enum MaterialType {
  stone
  metal
  glass
  wood
  fabric
  leather
  marble
  stone_composite @map("stone-composite")
}

/// Lifecycle state of a checkout order.
enum OrderStatus {
  pending
  paid
  failed
  cancelled
}

/// Fulfillment lifecycle — separate from payment status. Admin-editable.
///
/// Forward-only: `unfulfilled → processing → shipped → delivered`, with any
/// forward step skippable (an admin can ship without marking `processing`) and
/// `cancelled` reachable from anywhere. Backwards moves and moves out of a
/// terminal state are refused — see lib/orders/lifecycle.ts, which is the single
/// source of truth for the rules. Only a `paid` order may progress; cancelling
/// is allowed from any payment state.
enum FulfillmentStatus {
  unfulfilled
  processing
  shipped
  delivered
  cancelled
}

/// lib/data/product-categories/types.ts -> ProductCategory
model ProductCategory {
  id        String   @id
  slug      String   @unique
  /// Translation key prefix, e.g. "products.coffeeTables".
  i18nKey   String
  /// Localized { en, fa }
  name      Json
  /// Admin drag-reorder position (matches the order of `productCategories`).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_category")
}

/// lib/data/designers.ts -> Designer
model Designer {
  id        String   @id
  slug      String   @unique
  /// Localized { en, fa }
  name      Json
  image     String
  website   String?
  /// Localized[] — array of biography paragraphs.
  bio       Json
  /// Display position (matches the order of `designers`).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("designer")
}

/// lib/data/product-categories/types.ts -> Product
model Product {
  id            String   @id
  slug          String   @unique
  /// Localized { en, fa }
  name          Json
  hoverImage    String
  /// Optional Media link for `hoverImage` (Pass 13.5C). NULL means the image is
  /// still served from the legacy URL column — every row in the dev database is
  /// currently an EXTERNAL url (picsum/henge07/dummyimage), and the plan forbids
  /// converting those. `SetNull`: deleting the Media row must never delete the
  /// product, and the legacy URL remains as the fallback.
  hoverMediaId String?
  /// Shown to en-locale visitors, informational only (the charged amount is
  /// priceToman — see below).
  priceEur     Decimal  @db.Decimal(12, 2)
  /// Price in Toman, admin-entered independently of priceEur. Shown to
  /// fa-locale visitors and the ONLY value ever charged via ZarinPal (×10 to
  /// Rial at the API boundary). priceToman <= 0 means "not available for
  /// purchase" — the buy button is disabled, same as existsInStore: false.
  priceToman   Decimal  @default(0) @db.Decimal(14, 0)
  /// Product.store.existsInStore in the source data.
  existsInStore Boolean  @default(false)
  /// Product.store.quantity in the source data.
  quantity      Int      @default(0)
  heroImage     String
  /// Optional Media link for `heroImage`; see `hoverMediaId` above.
  heroMediaId  String?
  /// Localized { en, fa }
  description   Json
  /// Localized { en, fa } — optional in the source data.
  moreInfo      Json?
  /// DownloadLink[] — [{ label: Localized, href: string }]
  downloads     Json
  /// RelatedProduct[] — kept denormalized (name/slug/category/image snapshot)
  /// until the admin dashboard decides whether this becomes a self-relation.
  related       Json
  /// Display position within its category (matches the source array order).
  sortOrder     Int      @default(0)
  /// ProductCategory.id — the FK column holds the parent's `id` (not slug);
  /// see the FK convention note above the catalog models. The URL route param
  /// is still a category *slug*, resolved to this id by the repository layer.
  categoryId    String
  /// Designer.id — derived from Product.designer.href; null when no designer
  /// record matches the href. References Designer.id (not slug).
  designerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  designer      Designer?        @relation(fields: [designerId], references: [id], onDelete: SetNull)
  heroMedia     Media?           @relation("ProductHeroMedia", fields: [heroMediaId], references: [id], onDelete: SetNull)
  hoverMedia    Media?           @relation("ProductHoverMedia", fields: [hoverMediaId], references: [id], onDelete: SetNull)
  projectsUsed  ProjectProduct[]
  productImages ProductImage[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([designerId])
  @@index([heroMediaId])
  @@index([hoverMediaId])
  @@map("product")
}

/// lib/data/collections.ts -> Collection
model Collection {
  id          String   @id
  slug        String   @unique
  /// Localized { en, fa }
  name        Json
  /// Kept as a string: the source data uses "2026", not a number.
  year        String
  image       String
  /// CollectionDescription — { p1: Localized, p2: Localized, p3: Localized }
  description Json
  /// Display position (matches the order of `collections`).
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("collection")
}

/// lib/data/materials.ts -> Material
model Material {
  id          String       @id
  /// Added on top of the source `id` (already URL-safe) so materials have a
  /// stable route param like every other entity.
  slug        String       @unique
  /// Localized { en, fa }
  name        Json
  /// Free-form display group ("Stone", "Metal", ...).
  category    String
  type        MaterialType
  image       String
  /// Localized { en, fa }
  description Json
  /// Display position (matches the order of `materials`).
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
  @@map("material")
}

/// lib/data/materials.ts `fabrics[]` -> FabricItem
///
/// FabricItem is a separate entity from Material — materials cover stone/metal/
/// glass/wood/etc., while fabric items are upholstery textile swatches with
/// codes and colors. They are NOT merged.
///
/// Source: the `fabrics: FabricItem[]` array in lib/data/materials.ts. Preserves
/// existing identifiers/slugs, ordering, and the category field from the static data.
model FabricItem {
  /// Stable identifier matching the static data's `id` (e.g. "abarth-26").
  /// Also serves as the slug for any future `/fabrics/<id>` route.
  id          String   @id
  /// Fabric name from the static data (plain string, not localized in the source).
  name        String
  /// Fabric code from the static data (e.g. "26").
  code        String
  /// Category grouping from the static data (e.g. "Fabrics").
  category    String
  /// Swatch color from the static data (hex, e.g. "#726A50"). Placeholder until
  /// real photography is available.
  swatchColor String
  /// Display position (matches the order of the `fabrics` array in the static data).
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fabric_item")
}

/// lib/data/catalogue.ts -> CatalogueItem
///
/// CatalogueItem represents a catalogue PDF/card shown on the `/catalogue` page.
/// Previously a hardcoded static array; now a real database entity that can be
/// managed from the admin dashboard.
///
/// Source: the `catalogueItems: CatalogueItem[]` array in lib/data/catalogue.ts.
/// Preserves existing identifiers/slugs, ordering, and cover colors from the static data.
model CatalogueItem {
  /// Stable identifier matching the static data's `id` (e.g. "s34-5").
  /// Also serves as the slug for any future `/catalogue/<id>` route.
  id             String   @id
  /// Catalogue title (e.g. "S34/5").
  title          String
  /// Direct link to the PDF file.
  href           String
  /// Cover background color (hex, e.g. "#3a3530").
  coverColor     String
  /// Cover text color (hex, optional, e.g. "#232323").
  coverTextColor String?
  /// Display position (matches the order of the `catalogueItems` array in the static data).
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Homepage catalogue feature slots that reference this item.
  catalogueFeatures CatalogueFeature[]

  @@map("catalogue_item")
}

/// lib/data/flagships.ts -> Flagship (+ FlagshipDetail)
model Flagship {
  id        String   @id
  slug      String   @unique
  /// Localized { en, fa }
  name      Json
  /// Localized { en, fa }
  city      Json
  image     String
  /// FlagshipDetail from `flagshipDetails[slug]` — null for flagships whose
  /// detail page is not built yet (matches getFlagshipDetail() returning
  /// undefined today). Holds heroImage, heading, description, info
  /// (addressLines/hours/appointmentNote/phone/email), video and gallery.
  detail    Json?
  /// Display position (matches the order of `flagships`).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Homepage flagship-one feature slots that reference this flagship.
  flagshipOneFeatures FlagshipOneFeature[]

  @@map("flagship")
}

/// lib/data/projects.ts -> Project
model Project {
  id              String   @id
  /// Added on top of the source `id` (already URL-safe) so projects have a
  /// stable route param, independent of `i18nKey`.
  slug            String   @unique
  /// Translation key prefix, e.g. "projects.hIstra".
  i18nKey         String
  /// Localized { en, fa }
  name            Json
  location        String
  /// Kept as a string: the source data uses "2026", not a number.
  year            String
  image           String
  /// Localized { en, fa }
  description     Json
  /// Localized { en, fa } — long-form paragraph.
  paragraph       Json
  /// Localized[] — two extra description paragraphs.
  moreDescription Json
  /// (Localized | string)[] — mixed entries are valid in the source data.
  credits         Json
  portfolioImages String[]
  /// Display position (matches the order of projects).
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productsUsed                  ProjectProduct[]
  /// Homepage feature slots that reference this project.
  projectBannerFeatures         ProjectBannerFeature[]
  projectDarkBackgroundFeatures ProjectDarkBackgroundFeature[]

  @@map("project")
}

/// One image belonging to a Product. Replaces the flat `images String[]` array
/// on Product with a proper relational model that supports ordering, primary
/// image designation, and alt text.
///
/// Source: the `images` array that was previously embedded on Product records
/// in `lib/data/product-categories/*`. The seed synthesizes ProductImage rows
/// from those arrays so this table is populated automatically.
///
/// FK convention: references the parent's `id` (not `slug`), per the schema-wide
/// convention noted above the catalog models. `slug` is a route handle only.
model ProductImage {
  id        String  @id
  /// Product.id — the image belongs to this product (id-based FK; `slug` is
  /// the route handle, not the referential key).
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Publicly served image URL/path.
  ///
  /// RETAINED as the fallback source (Pass 13.5C). Every existing row holds an
  /// EXTERNAL url that cannot be converted to Media safely, so both columns are
  /// live and `media.url` simply wins when a Media link exists.
  url       String
  /// Pass 13.5C — the central Media record this image points at. This is the
  /// real database relationship (an id FK), NOT the url: the plan forbids
  /// relating by url/filename/slug/storageKey. Nullable because most rows are
  /// still legacy-url-sourced; `SetNull` so removing a Media row never deletes
  /// a product image (see docs: remove-relationship ≠ delete-media).
  mediaId   String?
  /// Alt text for accessibility / SEO.
  alt       String?
  /// Zero-based display order inside the product's image list.
  sortOrder Int     @default(0)
  /// Whether this image is the primary/hero image for the product.
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media     Media?  @relation("ProductImageMedia", fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([mediaId])
  @@map("product_image")
}

/// Join table for Project.productsUsed <-> Product (many-to-many) with an
/// explicit display order, mirroring the `pickProducts()` result order.
model ProjectProduct {
  /// Project.id / Product.id — id-based FKs (see header note above catalog).
  projectId String
  productId String
  /// Zero-based position inside the project's product list.
  order     Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([projectId, productId])
  @@index([productId])
  @@map("project_product")
}

// ---------------------------------------------------------------------------
// Slug rename redirect history.
//
// When an entity's slug changes (admin CRUD, Step 7), recordSlugChange()
// inserts a row here *before* the slug update runs. Public dynamic routes
// then look up the old slug here on a 404 and permanently redirect to the
// current URL, so inbound links / bookmarks don't break.
//
// Next's App Router has no 301 emitter: `permanentRedirect()` serves an HTTP
// 308 (Permanent) in a server-rendered route — the supported equivalent of a
// 301 for this purpose. A literal 301 is only possible via next.config.js
// redirects or the Proxy (see lib/repositories/slug-history.ts).
// ---------------------------------------------------------------------------
model SlugHistory {
  id        String   @id @default(uuid())
  modelType String
  entityId  String
  oldSlug   String
  createdAt DateTime @default(now())

  @@unique([modelType, oldSlug])
  @@index([entityId])
  @@map("slug_history")
}

// ---------------------------------------------------------------------------
// Checkout orders (myPlan.md — Part A, Part D).
//
// Every stored amount in this model pair is TOMAN. That is the only unit ever
// charged: OrderItem.unitPriceAtPurchase snapshots Product.priceToman and never
// Product.priceEur (EUR exists purely to display a price to en-locale visitors).
// The Toman -> Rial conversion required by the ZarinPal API happens at the
// gateway boundary in lib/payments/zarinpal.ts (`toRial`) and is NOT stored.
// Prices are Decimal and OrderItem.unitPriceAtPurchase is an immutable snapshot;
// order history never reads a later Product row.
// ---------------------------------------------------------------------------

model Order {
  id                 String            @id @default(uuid())
  userId             String
  status             OrderStatus       @default(pending)
  fulfillmentStatus  FulfillmentStatus @default(unfulfilled)
  totalAmount        Decimal           @db.Decimal(14, 0)
  /// Always "TOMAN" — the unit of totalAmount/OrderItem rows.
  currency           String            @default("TOMAN")
  /// The ZarinPal authority issued for this order's payment request. The
  /// callback resolves an order FROM THIS VALUE (`findOrderByAuthority`), never
  /// from a client-supplied order id — see lib/payments/settlement.ts.
  ///
  /// Indexed because that lookup runs on every customer return from the
  /// gateway; without an index it is a sequential scan of the whole table.
  /// Deliberately NOT `@unique`: the value is issued by ZarinPal, and a unique
  /// constraint would convert any historical duplicate into a failed INSERT at
  /// checkout time — breaking new orders to police data that does not exist.
  zarinpalAuthority  String?
  zarinpalRefId      String?
  /// Duplicate-checkout guard (Pass 14). A UUID generated once per checkout
  /// ATTEMPT in the browser and sent with the payload. The unique index makes a
  /// double-submit — a double-click, a retry, a replayed request — collide with
  /// the first insert instead of creating a second order and claiming stock
  /// twice. Nullable so pre-existing rows and any future non-idempotent writer
  /// are unaffected (Postgres allows many NULLs in a unique index).
  idempotencyKey     String?           @unique
  recipientName      String
  phone              String
  addressLine        String
  city               String
  postalCode         String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([fulfillmentStatus])
  @@index([zarinpalAuthority])
  @@map("order")
}

model OrderItem {
  id                 String   @id @default(uuid())
  orderId            String
  /// Nullable with SetNull so deleting a catalog product does not delete order
  /// history; name/image/price remain available from this snapshot.
  productId          String?
  quantity           Int
  /// Snapshot of Product.priceToman — the unit is TOMAN, never EUR. This is the
  /// real transaction record: never ambiguous, never derived from priceEur, and
  /// never re-read from the Product row later.
  unitPriceAtPurchase Decimal  @db.Decimal(14, 0)
  name               Json
  image              String
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_item")
}

// ---------------------------------------------------------------------------
// Homepage feature slots (myPlan.md — Part B).
//
// Every homepage banner/section is a singleton "feature" row that either
// *references* a catalog entity for its content (`reference` mode) or
// overrides the displayed text/image while the CTA keeps pointing at the
// referenced entity's canonical route (`override` mode). HomeCollectionBanner
// is the exception: standalone content with no FK and no mode toggle.
//
// Conventions: singleton rows use a stable derived `id` (AGENTS.md) so the
// seed can upsert idempotently and admin actions can address the row
// directly; FKs reference the parent's `id`, never its `slug`.
// ---------------------------------------------------------------------------

/// How a homepage feature derives its displayed content:
///   reference — kicker/title/paragraphs/image come from the linked entity,
///   override  — the nullable override columns on the feature row win.
/// The CTA destination is ALWAYS the linked entity's canonical route
/// (`/flagship/<slug>`, `/projects/<slug>`) — override mode only changes
/// what is displayed, never where the button goes.
enum FeatureMode {
  reference
  override
}

/// Homepage "Flagship One" banner slot — components/home/flagshipOne.tsx.
model FlagshipOneFeature {
  /// Singleton slot key ("flagship-one").
  id         String      @id
  enabled    Boolean     @default(true)
  mode       FeatureMode @default(reference)
  /// Flagship.id — id-based FK convention (slug is the route handle only).
  flagshipId String

  /// Override-mode content — all NULL while `mode = reference`.
  /// Localized { en, fa } — override kicker.
  kicker     Json?
  /// Localized { en, fa } — override title.
  title      Json?
  /// Localized[] — override paragraphs.
  paragraphs Json?
  /// Override image URL/path (reference mode reads Flagship.image).
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  flagship Flagship @relation(fields: [flagshipId], references: [id], onDelete: Cascade)

  @@index([flagshipId])
  @@map("flagship_one_feature")
}

/// Homepage "Project Banner" slot — components/home/projectBanner.tsx
/// (the H Istra banner).
model ProjectBannerFeature {
  /// Singleton slot key ("project-banner").
  id        String      @id
  enabled   Boolean     @default(true)
  mode      FeatureMode @default(reference)
  /// Project.id — id-based FK convention (slug is the route handle only).
  projectId String

  /// Override-mode content — all NULL while `mode = reference`.
  /// Localized { en, fa } — override kicker.
  kicker    Json?
  /// Localized { en, fa } — override title.
  title     Json?
  /// Override image URL/path (reference mode reads Project.image).
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_banner_feature")
}

/// Homepage "Project with dark background" slot —
/// components/home/projectWithDarkBackground.tsx (the Vocla 2026 banner).
model ProjectDarkBackgroundFeature {
  /// Singleton slot key ("project-dark-background").
  id        String      @id
  enabled   Boolean     @default(true)
  mode      FeatureMode @default(reference)
  /// Project.id — id-based FK convention (slug is the route handle only).
  projectId String

  /// Override-mode content — all NULL while `mode = reference`.
  /// Localized { en, fa } — override title.
  title      Json?
  /// Localized[] — override paragraphs.
  paragraphs Json?
  /// Override image URL/path (reference mode reads Project.image).
  image      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_dark_background_feature")
}

/// Homepage "Home Collection" banner — components/home/HomeCollectionBanner.tsx.
/// Standalone content: no entity FK and no mode toggle — the slot owns its
/// content outright.
model HomeCollectionFeature {
  /// Singleton slot key ("home-collection").
  id        String   @id
  enabled   Boolean  @default(true)
  image     String
  /// Localized { en, fa }
  title     Json
  /// Localized { en, fa } — description paragraph under the title.
  text      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("home_collection_feature")
}

/// Homepage "Catalogue" section — components/home/CatalogueSection.tsx.
/// Title + PDF href come from the referenced CatalogueItem; the section's
/// photo lives here because CatalogueItem has no image column (only a cover
/// color) — it moved from lib/data/homepage.ts `catalogue.image`.
model CatalogueFeature {
  /// Singleton slot key ("catalogue").
  id              String   @id
  enabled         Boolean  @default(true)
  /// CatalogueItem.id — id-based FK convention.
  catalogueItemId String
  /// Section photo URL/path (moved from lib/data/homepage.ts).
  image           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogueItem CatalogueItem @relation(fields: [catalogueItemId], references: [id], onDelete: Cascade)

  @@index([catalogueItemId])
  @@map("catalogue_feature")
}

// ---------------------------------------------------------------------------
// About & S34 Page Sections (myPlan.md — Part B).
//
// Structured section content for the /about and /s34 editorial pages.
// Replaces hardcoded translation dictionaries with database records that can
// be edited from the admin panel while preserving Localized { en, fa } shapes.
// ---------------------------------------------------------------------------

/// One section of the /about page (e.g. heroSection, brandStorySection, etc.).
model AboutPageSection {
  id         String   @id @default(uuid())
  /// Machine-readable section identifier, e.g. "heroSection", "conceptSection".
  sectionKey String   @unique
  /// Display position on the page.
  sortOrder  Int      @default(0)
  /// Localized title/kicker/paragraphs/images as applicable per section.
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("about_page_section")
}

/// One section of the /s34 page (e.g. heroSection, conceptSection, etc.).
model S34PageSection {
  id         String   @id @default(uuid())
  /// Machine-readable section identifier, e.g. "heroSection", "conceptSection".
  sectionKey String   @unique
  /// Display position on the page.
  sortOrder  Int      @default(0)
  /// Localized title/kicker/paragraphs/images as applicable per section.
  content    Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("s34_page_section")
}

// ---------------------------------------------------------------------------
// Media (Pass 13.5 — myPlan.md).
//
// Central METADATA registry for uploaded assets. This is the foundation the
// rest of the app will eventually reference, replacing scattered image URL
// strings on individual catalog models. Nothing is migrated in this pass: the
// catalog models keep their URL columns and this table is additive.
//
// Two rules this model exists to enforce:
//   1. BINARY FILES ARE NOT STORED HERE. Postgres holds metadata only; the
//      bytes live in the storage provider (Vercel Blob today, see
//      lib/media/*). `url` is the resolved public URL, `storageKey` is the
//      provider-side identifier used to delete/replace the object.
//   2. THE STORAGE KEY IS THE TRUTH, NOT THE URL. Several providers can serve
//      one object from more than one URL, so cleanup/deletion always resolves
//      through `storageKey` and URL matching is best-effort fallback only.
//
// Conventions (see AGENTS.md + the media/repository sections):
//   - `id` is a uuid surrogate (`@default(uuid())`, like Order/OrderItem):
//     media rows are created by an action at runtime, not seeded from a stable
//     source key, so there is no derived id to inherit.
//   - `filename` is the ORIGINAL client filename, kept for display/download;
//     it is never used to build a path (see lib/media validation).
//   - `width`/`height`/`duration` are nullable because the current upload path
//     does not decode the file. A later hardening pass (video, probe-on-upload)
//     may backfill them; nothing may assume they are present.
//   - `storageKey @unique` is what makes deletion-by-key reliable and prevents
//     two rows from owning the same object; the database, not application
//     logic, is the last line of defence against an orphaned duplicate.
//   - `alt`/`title` are optional human metadata (accessibility + admin search);
//     they are NOT `Json` because media is not localized here — the entity that
//     *references* media owns any localized copy.
// ---------------------------------------------------------------------------

/// Kind of asset a Media row describes. Kept as an enum so a future non-image
/// type (video already, documents later) can be added with one migration, and
/// so queries can filter by kind without string matching.
enum MediaType {
  image
  video
}

/// Pass 13.5D — the ONE global configuration row.
///
/// Deliberately a single row rather than a key/value table: there is exactly one
/// website, a settings screen edits the whole object at once, and a singleton
/// keeps the type CHECKED (a key/value store would make every field a string and
/// move all validation into runtime lookups).
///
/// `id` is a fixed literal so an upsert is idempotent and a second row can never
/// be created by accident. Every `Media` reference is an id FK — no blob URLs,
/// filenames or storage keys are stored here (the plan is explicit about that).
model SiteSettings {
  /// Fixed singleton key — see the model note above.
  id              String   @id @default("singleton")
  /// Localized { en, fa } — the brand name shown in the navbar/footer when no
  /// logo image is set.
  siteName        Json
  /// Localized { en, fa } — default SEO description.
  siteDescription Json
  /// Optional brand logo image. NULL = fall back to the text wordmark.
  logoMediaId     String?
  /// Optional favicon. NULL = fall back to the static app/favicon.ico.
  faviconMediaId  String?
  phone           String?
  email           String?
  /// Localized { en, fa }
  address         Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // SetNull, never Cascade: deleting a Media row must not delete the settings.
  logoMedia    Media? @relation("SiteLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  faviconMedia Media? @relation("SiteFaviconMedia", fields: [faviconMediaId], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

/// Pass 13.5D — footer/contact social links, database-driven.
///
/// Data ONLY: `platform` is a stable machine key ("instagram", "telegram", …)
/// that the FRONTEND maps to an icon. No React components, no SVG, no icon
/// markup is ever stored here. An unrecognised platform renders a fallback icon
/// rather than crashing, so a new platform can be added without a code change.
model SocialLink {
  id        String   @id @default(uuid())
  /// Machine key matched against the frontend icon map; unknown values are
  /// allowed and render a neutral fallback.
  platform  String
  /// Accessible label (also the tooltip).
  label     String
  url       String
  /// Display position, ascending.
  sortOrder Int      @default(0)
  /// Inactive links are hidden from the public site but kept in the admin.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("social_link")
}

model Media {
  id          String    @id @default(uuid())
  /// Original client filename (display/download only — never a path segment).
  filename    String
  /// Provider-side object identifier (the key used by upload/delete). Unique so
  /// two rows can never own one object; this is the deletion handle.
  storageKey  String    @unique
  /// Resolved public URL served to the browser. Stored (not derived) because
  /// the provider is the single source of truth for the URL shape.
  url         String
  mimeType    String
  /// Size in bytes.
  size        Int
  /// Nullable: the current upload path does not decode the file. Backfilled by
  /// the later media-hardening pass (video/dimension probing).
  width       Int?
  height      Int?
  /// Duration in SECONDS (nullable, video only) — reserved for the later
  /// large-video pass; images leave it null.
  duration    Int?  /// Accessibility alt text / admin-facing label. Optional.
  alt         String?
  title       String?
  mediaType   MediaType @default(image)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Pass 13.5C back-relations. ONE Media row may be referenced by MANY entities
  // (a shared image on two products) — these are the "many" sides, which is
  // exactly why removing an image from one entity must only delete the join row
  // and never the Media itself (docs: remove-relationship ≠ delete-media).
  productHeroes  Product[]       @relation("ProductHeroMedia")
  productHovers  Product[]       @relation("ProductHoverMedia")
  productImages  ProductImage[]  @relation("ProductImageMedia")
  // Pass 13.5D brand assets.
  siteLogos      SiteSettings[]  @relation("SiteLogoMedia")
  siteFavicons   SiteSettings[]  @relation("SiteFaviconMedia")

  @@index([mediaType])
  @@index([createdAt])
  @@map("media")
}
