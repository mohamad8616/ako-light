// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  /// Allowed values: "user" | "admin" | "owner"
  role                String    @default("user")
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  /// Ban support required by better-auth's admin plugin.
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  /// Set when an owner/admin impersonates this session (admin plugin).
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Catalog / content domain
//
// Mirrors the static data under lib/data/* (which stays the live source for
// the site until reads are switched over to the database).
//
// Conventions (see AGENTS.md):
//   - `Localized` values ({ en, fa }) stay in ONE `Json` column (jsonb) so the
//     `Localized` type keeps working unchanged in the app.
//   - Ordered string[] / object[] content also lives in `Json` (order is part
//     of the content: paragraphs, gallery lists, downloads, related items).
//   - `id` identifies the row, `slug` is the human/route handle.
//   - Parent/child FKs reference the parent's `slug`, because that is exactly
//     what the source data stores (e.g. `Product.category` holds a
//     ProductCategory slug, `Product.designer.href` ends with a Designer slug).
// ---------------------------------------------------------------------------

/**
 * Material finish type. Mirrors the union in lib/data/materials.ts:
 * stone | metal | glass | wood | fabric | leather | marble | stone-composite.
 * `stone_composite` is `@map`ped so the database stores the exact
 * "stone-composite" string used by the source data; the Prisma client exposes
 * it as `MaterialType.stone_composite` (hyphens are not valid in Prisma enum
 * value names).
 */
enum MaterialType {
  stone
  metal
  glass
  wood
  fabric
  leather
  marble
  stone_composite @map("stone-composite")
}

/// lib/data/product-categories/types.ts -> ProductCategory
model ProductCategory {
  id        String   @id
  slug      String   @unique
  /// Translation key prefix, e.g. "products.coffeeTables".
  i18nKey   String
  /// Localized { en, fa }
  name      Json
  /// Admin drag-reorder position (matches the order of `productCategories`).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_category")
}

/// lib/data/designers.ts -> Designer
model Designer {
  id        String   @id
  slug      String   @unique
  /// Localized { en, fa }
  name      Json
  image     String
  website   String?
  /// Localized[] — array of biography paragraphs.
  bio       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("designer")
}

/// lib/data/product-categories/types.ts -> Product
model Product {
  id            String   @id
  slug          String   @unique
  /// Localized { en, fa }
  name          Json
  images        String[]
  hoverImage    String
  price         Decimal  @db.Decimal(12, 2)
  /// Product.store.existsInStore in the source data.
  existsInStore Boolean  @default(false)
  /// Product.store.quantity in the source data.
  quantity      Int      @default(0)
  heroImage     String
  /// Localized { en, fa }
  description   Json
  /// Localized { en, fa } — optional in the source data.
  moreInfo      Json?
  /// DownloadLink[] — [{ label: Localized, href: string }]
  downloads     Json
  /// RelatedProduct[] — kept denormalized (name/slug/category/image snapshot)
  /// until the admin dashboard decides whether this becomes a self-relation.
  related       Json
  /// ProductCategory.slug ("coffee-tables", ...) — see FK convention above.
  categoryId    String
  /// Designer.slug derived from Product.designer.href; null when no designer
  /// record matches the href.
  designerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category     ProductCategory  @relation(fields: [categoryId], references: [slug], onDelete: Cascade)
  designer     Designer?        @relation(fields: [designerId], references: [slug], onDelete: SetNull)
  projectsUsed ProjectProduct[]

  @@index([categoryId])
  @@index([designerId])
  @@map("product")
}

/// lib/data/collections.ts -> Collection
model Collection {
  id          String   @id
  slug        String   @unique
  /// Localized { en, fa }
  name        Json
  /// Kept as a string: the source data uses "2026", not a number.
  year        String
  image       String
  /// CollectionDescription — { p1: Localized, p2: Localized, p3: Localized }
  description Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("collection")
}

/// lib/data/materials.ts -> Material
model Material {
  id          String       @id
  /// Added on top of the source `id` (already URL-safe) so materials have a
  /// stable route param like every other entity.
  slug        String       @unique
  /// Localized { en, fa }
  name        Json
  /// Free-form display group ("Stone", "Metal", ...).
  category    String
  type        MaterialType
  image       String
  /// Localized { en, fa }
  description Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([category])
  @@map("material")
}

/// lib/data/flagships.ts -> Flagship (+ FlagshipDetail)
model Flagship {
  id        String   @id
  slug      String   @unique
  /// Localized { en, fa }
  name      Json
  /// Localized { en, fa }
  city      Json
  image     String
  /// FlagshipDetail from `flagshipDetails[slug]` — null for flagships whose
  /// detail page is not built yet (matches getFlagshipDetail() returning
  /// undefined today). Holds heroImage, heading, description, info
  /// (addressLines/hours/appointmentNote/phone/email), video and gallery.
  detail    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("flagship")
}

/// lib/data/projects.ts -> Project
model Project {
  id              String   @id
  /// Added on top of the source `id` (already URL-safe) so projects have a
  /// stable route param, independent of `i18nKey`.
  slug            String   @unique
  /// Translation key prefix, e.g. "projects.hIstra".
  i18nKey         String
  /// Localized { en, fa }
  name            Json
  location        String
  /// Kept as a string: the source data uses "2026", not a number.
  year            String
  image           String
  /// Localized { en, fa }
  description     Json
  /// Localized { en, fa } — long-form paragraph.
  paragraph       Json
  /// Localized[] — two extra description paragraphs.
  moreDescription Json
  /// (Localized | string)[] — mixed entries are valid in the source data.
  credits         Json
  portfolioImages String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  productsUsed ProjectProduct[]

  @@map("project")
}

/// Join table for Project.productsUsed <-> Product (many-to-many) with an
/// explicit display order, mirroring the `pickProducts()` result order.
model ProjectProduct {
  /// Project.slug / Product.slug — repo FK convention (see header note).
  projectId String
  productId String
  /// Zero-based position inside the project's product list.
  order     Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [slug], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [slug], onDelete: Cascade)

  @@id([projectId, productId])
  @@index([productId])
  @@map("project_product")
}
