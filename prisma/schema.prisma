// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id
  name                String
  email               String
  emailVerified       Boolean   @default(false)
  image               String?
  /// Allowed values: "user" | "admin" | "owner"
  role                String    @default("user")
  phoneNumber         String?   @unique
  phoneNumberVerified Boolean   @default(false)
  /// Optional referral/invitation code captured on the phone-entry step and
  /// stored on sign-up only (passed through phoneNumber.verify() — see
  /// user.additionalFields in lib/auth/auth.ts). Null for email sign-ups
  /// and for phone logins where no code was typed.
  referredByCode      String?
  /// Ban support required by better-auth's admin plugin.
  banned              Boolean   @default(false)
  banReason           String?
  banExpires          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  accounts            Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  /// Set when an owner/admin impersonates this session (admin plugin).
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Catalog / content domain
//
// Mirrors the static data under lib/data/* (which stays the live source for
// the site until reads are switched over to the database).
//
// Conventions (see AGENTS.md):
//   - `Localized` values ({ en, fa }) stay in ONE `Json` column (jsonb) so the
//     `Localized` type keeps working unchanged in the app.
//   - Ordered string[] / object[] content also lives in `Json` (order is part
//     of the content: paragraphs, gallery lists, downloads, related items).
//   - `id` identifies the row, `slug` is the human/route handle.
//   - Parent/child FKs reference the parent's `id` (not `slug`): slugs are
//     human/route handles and may change, so they must not be load-bearing for
//     relational integrity. Each FK column is named after the parent entity's
//     `id` (e.g. `Product.categoryId` → `ProductCategory.id`).
//     `slug` remains a `@unique` column used for URL routing / `getBySlug` lookups
//     but is never used as a foreign-key target.
//   - When an entity's slug changes, its old slug is recorded in `SlugHistory`
//     so that inbound links to the old URL can 301-redirect to the new slug.
// ---------------------------------------------------------------------------

/**
 * Material finish type. Mirrors the union in lib/data/materials.ts:
 * stone | metal | glass | wood | fabric | leather | marble | stone-composite.
 * `stone_composite` is `@map`ped so the database stores the exact
 * "stone-composite" string used by the source data; the Prisma client exposes
 * it as `MaterialType.stone_composite` (hyphens are not valid in Prisma enum
 * value names).
 */
enum MaterialType {
  stone
  metal
  glass
  wood
  fabric
  leather
  marble
  stone_composite @map("stone-composite")
}

/// lib/data/product-categories/types.ts -> ProductCategory
model ProductCategory {
  id        String   @id
  slug      String   @unique
  /// Translation key prefix, e.g. "products.coffeeTables".
  i18nKey   String
  /// Localized { en, fa }
  name      Json
  /// Admin drag-reorder position (matches the order of `productCategories`).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("product_category")
}

/// lib/data/designers.ts -> Designer
model Designer {
  id        String   @id
  slug      String   @unique
  /// Localized { en, fa }
  name      Json
  image     String
  website   String?
  /// Localized[] — array of biography paragraphs.
  bio       Json
  /// Display position (matches the order of `designers`).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("designer")
}

/// lib/data/product-categories/types.ts -> Product
model Product {
  id            String   @id
  slug          String   @unique
  /// Localized { en, fa }
  name          Json
  hoverImage    String
  price         Decimal  @db.Decimal(12, 2)
  /// Product.store.existsInStore in the source data.
  existsInStore Boolean  @default(false)
  /// Product.store.quantity in the source data.
  quantity      Int      @default(0)
  heroImage     String
  /// Localized { en, fa }
  description   Json
  /// Localized { en, fa } — optional in the source data.
  moreInfo      Json?
  /// DownloadLink[] — [{ label: Localized, href: string }]
  downloads     Json
  /// RelatedProduct[] — kept denormalized (name/slug/category/image snapshot)
  /// until the admin dashboard decides whether this becomes a self-relation.
  related       Json
  /// Display position within its category (matches the source array order).
  sortOrder     Int      @default(0)
  /// ProductCategory.id — the FK column holds the parent's `id` (not slug);
  /// see the FK convention note above the catalog models. The URL route param
  /// is still a category *slug*, resolved to this id by the repository layer.
  categoryId    String
  /// Designer.id — derived from Product.designer.href; null when no designer
  /// record matches the href. References Designer.id (not slug).
  designerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category     ProductCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  designer     Designer?        @relation(fields: [designerId], references: [id], onDelete: SetNull)
  projectsUsed ProjectProduct[]
  productImages ProductImage[]

  @@index([categoryId])
  @@index([designerId])
  @@map("product")
}

/// lib/data/collections.ts -> Collection
model Collection {
  id          String   @id
  slug        String   @unique
  /// Localized { en, fa }
  name        Json
  /// Kept as a string: the source data uses "2026", not a number.
  year        String
  image       String
  /// CollectionDescription — { p1: Localized, p2: Localized, p3: Localized }
  description Json
  /// Display position (matches the order of `collections`).
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("collection")
}

/// lib/data/materials.ts -> Material
model Material {
  id          String       @id
  /// Added on top of the source `id` (already URL-safe) so materials have a
  /// stable route param like every other entity.
  slug        String       @unique
  /// Localized { en, fa }
  name        Json
  /// Free-form display group ("Stone", "Metal", ...).
  category    String
  type        MaterialType
  image       String
  /// Localized { en, fa }
  description Json
  /// Display position (matches the order of `materials`).
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
  @@map("material")
}

/// lib/data/materials.ts `fabrics[]` -> FabricItem
///
/// FabricItem is a separate entity from Material — materials cover stone/metal/
/// glass/wood/etc., while fabric items are upholstery textile swatches with
/// codes and colors. They are NOT merged.
///
/// Source: the `fabrics: FabricItem[]` array in lib/data/materials.ts. Preserves
/// existing identifiers/slugs, ordering, and the category field from the static data.
model FabricItem {
  /// Stable identifier matching the static data's `id` (e.g. "abarth-26").
  /// Also serves as the slug for any future `/fabrics/<id>` route.
  id          String   @id
  /// Fabric name from the static data (plain string, not localized in the source).
  name        String
  /// Fabric code from the static data (e.g. "26").
  code        String
  /// Category grouping from the static data (e.g. "Fabrics").
  category    String
  /// Swatch color from the static data (hex, e.g. "#726A50"). Placeholder until
  /// real photography is available.
  swatchColor String
  /// Display position (matches the order of the `fabrics` array in the static data).
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("fabric_item")
}

/// lib/data/catalogue.ts -> CatalogueItem
///
/// CatalogueItem represents a catalogue PDF/card shown on the `/catalogue` page.
/// Previously a hardcoded static array; now a real database entity that can be
/// managed from the admin dashboard.
///
/// Source: the `catalogueItems: CatalogueItem[]` array in lib/data/catalogue.ts.
/// Preserves existing identifiers/slugs, ordering, and cover colors from the static data.
model CatalogueItem {
  /// Stable identifier matching the static data's `id` (e.g. "s34-5").
  /// Also serves as the slug for any future `/catalogue/<id>` route.
  id            String   @id
  /// Catalogue title (e.g. "S34/5").
  title         String
  /// Direct link to the PDF file.
  href          String
  /// Cover background color (hex, e.g. "#3a3530").
  coverColor    String
  /// Cover text color (hex, optional, e.g. "#232323").
  coverTextColor String?
  /// Display position (matches the order of the `catalogueItems` array in the static data).
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("catalogue_item")
}

/// lib/data/flagships.ts -> Flagship (+ FlagshipDetail)
model Flagship {
  id        String   @id
  slug      String   @unique
  /// Localized { en, fa }
  name      Json
  /// Localized { en, fa }
  city      Json
  image     String
  /// FlagshipDetail from `flagshipDetails[slug]` — null for flagships whose
  /// detail page is not built yet (matches getFlagshipDetail() returning
  /// undefined today). Holds heroImage, heading, description, info
  /// (addressLines/hours/appointmentNote/phone/email), video and gallery.
  detail    Json?
  /// Display position (matches the order of `flagships`).
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("flagship")
}

/// lib/data/projects.ts -> Project
model Project {
  id              String   @id
  /// Added on top of the source `id` (already URL-safe) so projects have a
  /// stable route param, independent of `i18nKey`.
  slug            String   @unique
  /// Translation key prefix, e.g. "projects.hIstra".
  i18nKey         String
  /// Localized { en, fa }
  name            Json
  location        String
  /// Kept as a string: the source data uses "2026", not a number.
  year            String
  image           String
  /// Localized { en, fa }
  description     Json
  /// Localized { en, fa } — long-form paragraph.
  paragraph       Json
  /// Localized[] — two extra description paragraphs.
  moreDescription Json
  /// (Localized | string)[] — mixed entries are valid in the source data.
  credits         Json
  portfolioImages String[]
  /// Display position (matches the order of projects).
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  productsUsed ProjectProduct[]

  @@map("project")
}

/// One image belonging to a Product. Replaces the flat `images String[]` array
/// on Product with a proper relational model that supports ordering, primary
/// image designation, and alt text.
///
/// Source: the `images` array that was previously embedded on Product records
/// in `lib/data/product-categories/*`. The seed synthesizes ProductImage rows
/// from those arrays so this table is populated automatically.
///
/// FK convention: references the parent's `id` (not `slug`), per the schema-wide
/// convention noted above the catalog models. `slug` is a route handle only.
model ProductImage {
  id        String   @id
  /// Product.id — the image belongs to this product (id-based FK; `slug` is
  /// the route handle, not the referential key).
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Publicly served image URL/path.
  url       String
  /// Alt text for accessibility / SEO.
  alt       String?
  /// Zero-based display order inside the product's image list.
  sortOrder Int      @default(0)
  /// Whether this image is the primary/hero image for the product.
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_image")
}

/// Join table for Project.productsUsed <-> Product (many-to-many) with an
/// explicit display order, mirroring the `pickProducts()` result order.
model ProjectProduct {
  /// Project.id / Product.id — id-based FKs (see header note above catalog).
  projectId String
  productId String
  /// Zero-based position inside the project's product list.
  order     Int
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([projectId, productId])
  @@index([productId])
  @@map("project_product")
}

// ---------------------------------------------------------------------------
// Slug rename redirect history.
//
// When an entity's slug changes (admin CRUD, Step 7), recordSlugChange()
// inserts a row here *before* the slug update runs. Public dynamic routes
// then look up the old slug here on a 404 and permanently redirect to the
// current URL, so inbound links / bookmarks don't break.
//
// Next's App Router has no 301 emitter: `permanentRedirect()` serves an HTTP
// 308 (Permanent) in a server-rendered route — the supported equivalent of a
// 301 for this purpose. A literal 301 is only possible via next.config.js
// redirects or the Proxy (see lib/repositories/slug-history.ts).
// ---------------------------------------------------------------------------
model SlugHistory {
  id        String   @id @default(uuid())
  modelType String
  entityId  String
  oldSlug   String
  createdAt DateTime @default(now())

  @@unique([modelType, oldSlug])
  @@index([entityId])
  @@map("slug_history")
}
