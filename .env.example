# ---------------------------------------------------------------------------
# Required environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (schema: prisma/schema.prisma).
# PostgreSQL >= 15 is required.
# For pooled providers (Supabase/Neon) use the pooler host and keep
# `sslmode=require` so migrations and the app can connect.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Public base URL of the running app. Used by the better-auth browser client
# (lib/auth/auth-client.ts). Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used by better-auth to sign sessions/cookies.
# Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""

# Server-side base URL better-auth uses for callbacks/redirects.
# Not needed when NEXT_PUBLIC_APP_URL is set to the same value.
BETTER_AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# SMS provider seam — lib/auth/sms.ts (not required yet)
# ---------------------------------------------------------------------------
# OTP codes are currently printed to the server console by the development
# mock ([DEV OTP] <phoneNumber>: <code>), so no SMS credential is needed to
# develop or test the phone-OTP flow. Set SMS_PROVIDER_API_KEY only once the
# TODO(sms-provider) block in lib/auth/sms.ts is implemented with a real
# Iranian gateway (Kavenegar / Melipayamak / SMS.ir / ...).
# While it stays unset, OTP sending REFUSES to run when NODE_ENV=production.
# SMS_PROVIDER_API_KEY=""
# SMS_PROVIDER_SENDER=""