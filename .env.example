# ---------------------------------------------------------------------------
# Required environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (schema: prisma/schema.prisma).
# PostgreSQL >= 15 is required.
# For pooled providers (Supabase/Neon) use the pooler host and keep
# `sslmode=require` so migrations and the app can connect.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Public base URL of the running app. Used by the better-auth browser client
# (lib/auth/auth-client.ts). Falls back to http://localhost:3000 in development.
# Must include the scheme (https://...). A bare domain without a scheme throws
# ERR_INVALID_URL inside better-auth during the production build.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used by better-auth to sign sessions/cookies.
# Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Order confirmation links — lib/orders/access-token.ts
# ---------------------------------------------------------------------------
# The receipt sent by SMS/email carries `?token=` so it opens for a customer
# who is signed out or on a different device. That token is an HMAC-SHA256
# signature over (order id + expiry) and is scoped to that one order, read-only
# — it is NOT a session and cannot reach any other route or the admin surface.
#
# Optional. When unset the signer falls back to BETTER_AUTH_SECRET, which is
# always present, so there is nothing to configure for a working link.
# Set it only to rotate link signing independently of the session secret —
# note that doing so invalidates every link already sent (30-day lifetime).
ORDER_ACCESS_TOKEN_SECRET=""

# Server-side base URL better-auth uses for callbacks/redirects.
# Must include the scheme (https://...). A bare domain without a scheme throws
# ERR_INVALID_URL during the production build.
BETTER_AUTH_URL="http://localhost:3000"
# ZarinPal payment integration. Sandbox is the default for local work.
# Merchant ID is a UUID from the ZarinPal panel.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_MODE="sandbox"
# ---------------------------------------------------------------------------
# Vercel Blob — real image uploads in the admin (lib/admin/actions/upload.ts)
# ---------------------------------------------------------------------------
# Admin image fields (product images, designer photo, collection/material/
# flagship images, homepage slot images) upload to Vercel Blob and store the
# resulting public URL in the same text column the form always used.
#
# Vercel provisions this token automatically, BUT ONLY ONCE BLOB STORAGE IS
# ENABLED ON THE PROJECT. Before relying on uploads confirm:
#   1. Vercel dashboard → project → Storage → the Blob store is connected to
#      this project (a store in another project/team does NOT emit a token here).
#   2. Project → Settings → Environment Variables → BLOB_READ_WRITE_TOKEN is
#      present for Production, Preview AND Development (it is created per
#      environment; connecting the store does not backfill the others).
#   3. `vercel env pull` after any change, so the local .env matches.
# Do not paste a real token into this file — it is committed; keep it in .env.
# Without the token the admin still loads and image URL fields work, but an
# upload fails with the shared upload error toast.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# SMS provider seam — lib/auth/sms.ts (sms.ir Verify integration)
# ---------------------------------------------------------------------------
# OTP codes are delivered through sms.ir's Verify API (lib/auth/sms.ts).
# While SMSIR_API_KEY stays unset the development mock ([DEV OTP] ...) is used,
# and production refuses to run without a real key.
#
# To go live with sms.ir:
#   1. Create a Sandbox API key via sms.ir panel:
#      برنامه‌نویسان → لیست کلیدهای API → ایجاد کلید جدید (type: Sandbox)
#      → copy it into SMSIR_API_KEY below (and locally in .env).
#   2. The Sandbox only supports the fixed Verify template "123456" whose text
#      is "کد تایید شما: #CODE#". This is SMSIR_VERIFY_TEMPLATE_ID's default.
#      Before going to production you MUST:
#        a. Create a real production API key (type: Production) and set it as
#           SMSIR_API_KEY.
#        b. Create a real production Verify template in the sms.ir panel and
#           set its ID as SMSIR_VERIFY_TEMPLATE_ID (replace the "123456" default).
#   3. Never commit real values of these variables — keep them out of version
#      control and set them in Vercel / your hosting environment.
SMSIR_API_KEY=""
SMSIR_VERIFY_TEMPLATE_ID="123456"

# ---------------------------------------------------------------------------
# Order receipts — lib/notifications/ (SMS + email after a successful payment)
# ---------------------------------------------------------------------------
# Once a ZarinPal payment verifies, the customer is sent an order receipt from
# the checkout callback route. Channel policy is SMS first, email as fallback
# (see lib/notifications/order-receipt.ts for why).

# Dedicated sms.ir sending line for PLAIN (non-template) messages.
# The order receipt uses POST /v1/send/bulk, which is a DIFFERENT endpoint from
# the OTP /send/verify and REQUIRES a line number. Verify does not need one,
# which is why this is a separate setting.
# Read it from the sms.ir panel (lines / شماره خطوط).
#
# CAUTION: sms.ir publishes a sandbox example ONLY for /send/verify. Their docs
# claim the sandbox mirrors production URL/input/output shapes, but there is no
# bulk sandbox example and no bulk sandbox template, so sandbox delivery for
# this endpoint is UNCONFIRMED. While SMSIR_LINE_NUMBER is unset the receipt is
# written to the server console instead ([DEV SMS] ...), so the flow is testable
# without a line or any gateway egress.
SMSIR_LINE_NUMBER=""

# SMTP — the project's only email path (lib/notifications/email.ts).
# Plain SMTP via nodemailer so any provider works (a free Gmail app-password,
# an Iranian host, or a paid relay) with no vendor lock-in.
# While SMTP_HOST is unset the message is written to the server console
# ([DEV EMAIL] ...); in production an unset SMTP_HOST throws.
SMTP_HOST=""
SMTP_PORT="587"
# Set to "true" for implicit TLS (normally port 465). Leave unset to infer it
# from the port.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER when unset.
SMTP_FROM=""