# ---------------------------------------------------------------------------
# Required environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (schema: prisma/schema.prisma).
# PostgreSQL >= 15 is required.
# For pooled providers (Supabase/Neon) use the pooler host and keep
# `sslmode=require` so migrations and the app can connect.
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Public base URL of the running app. Used by the better-auth browser client
# (lib/auth/auth-client.ts). Falls back to http://localhost:3000 in development.
# Must include the scheme (https://...). A bare domain without a scheme throws
# ERR_INVALID_URL inside better-auth during the production build.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used by better-auth to sign sessions/cookies.
# Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Order confirmation links — lib/orders/access-token.ts
# ---------------------------------------------------------------------------
# The receipt sent by SMS/email carries `?token=` so it opens for a customer
# who is signed out or on a different device. That token is an HMAC-SHA256
# signature over (order id + expiry) and is scoped to that one order, read-only
# — it is NOT a session and cannot reach any other route or the admin surface.
#
# Optional. When unset the signer falls back to BETTER_AUTH_SECRET, which is
# always present, so there is nothing to configure for a working link.
# Set it only to rotate link signing independently of the session secret —
# note that doing so invalidates every link already sent (30-day lifetime).
ORDER_ACCESS_TOKEN_SECRET=""

# Server-side base URL better-auth uses for callbacks/redirects.
# Must include the scheme (https://...). A bare domain without a scheme throws
# ERR_INVALID_URL during the production build.
BETTER_AUTH_URL="http://localhost:3000"
# ZarinPal payment integration. Sandbox is the default for local work.
#
# ZARINPAL_MERCHANT_ID MUST be the UUID ZarinPal issued (36 chars, 8-4-4-4-12
# hex) — not the merchant NAME, and never a placeholder. The app validates its
# SHAPE at startup (lib/env.ts) and refuses to boot otherwise.
#
# Why the shape is enforced: a value that is present but wrong makes ZarinPal
# reject every call with `code: 0`. That used to be recorded as a failed
# payment, which silently marked genuinely PAID orders as failed — for every
# customer, with no error anywhere. The runtime is now hardened too
# (lib/payments/zarinpal.ts classifies such a failure as a gateway fault and
# never writes a terminal "failed" status for it), but a bad id is still a
# one-line fix at boot and a pile of corrupted orders at runtime.
#
# ZARINPAL_MODE must be exactly "sandbox" or "production". Any other value is
# ignored and the app falls back to the sandbox host, so a production
# deployment would silently charge nobody; the preflight rejects it in
# production.
#
# NOTE (Pass 14.5): these are SERVER-ONLY variables. They are never read by a
# client component and must never be given a NEXT_PUBLIC_ prefix — doing so
# would ship the merchant id (a credential) to every visitor's browser. The
# only place they are read is lib/payments/zarinpal.ts, which runs exclusively
# on the server (the checkout callback route).
#
# Reconciliation is automatic and needs no extra configuration: a delayed
# successful verification for an order whose reservation the stale sweep
# already released re-claims the stock inside the settlement transaction. If
# the stock can no longer be satisfied the order is left `failed` and logged
# (`[payments] manual-review`) for a human — it is never marked paid with
# inventory the shop does not hold.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_MODE="sandbox"

# ---------------------------------------------------------------------------
# Stale pending order cleanup — Vercel Cron (vercel.json, daily at 03:00 UTC)
# ---------------------------------------------------------------------------
# REQUIRED before deploying the scheduled route. Set a distinct random value
# of at least 16 characters in Vercel's server-side Environment Variables.
# Vercel supplies `Authorization: Bearer <CRON_SECRET>` on scheduled GETs;
# without it (or with a short value) the route returns 401 and touches no DB.
# Never use a NEXT_PUBLIC_ prefix or commit the real secret.
CRON_SECRET=""
# A reservation becomes eligible only when Order.createdAt is STRICTLY older
# than this window. Default 1440 minutes (24 hours); allowed 60..10080.
# This is a conservative local policy, NOT a gateway-confirmed failure.
PENDING_ORDER_EXPIRATION_MINUTES="1440"
# Process at most this many orders per invocation (default 25; allowed 1..100).
# If more are due, the next daily run picks up the remainder. Check run logs
# and increase schedule frequency (plan permitting) for sustained backlogs.
CLEANUP_BATCH_SIZE="25"
# ---------------------------------------------------------------------------
# Vercel Blob — real image uploads in the admin (lib/admin/actions/upload.ts)
# ---------------------------------------------------------------------------
# Admin image fields (product images, designer photo, collection/material/
# flagship images, homepage slot images) upload to Vercel Blob and store the
# resulting public URL in the same text column the form always used.
#
# Vercel provisions this token automatically, BUT ONLY ONCE BLOB STORAGE IS
# ENABLED ON THE PROJECT. Before relying on uploads confirm:
#   1. Vercel dashboard → project → Storage → the Blob store is connected to
#      this project (a store in another project/team does NOT emit a token here).
#   2. Project → Settings → Environment Variables → BLOB_READ_WRITE_TOKEN is
#      present for Production, Preview AND Development (it is created per
#      environment; connecting the store does not backfill the others).
#   3. `vercel env pull` after any change, so the local .env matches.
#   4. **THE STORE IS SET TO PUBLIC ACCESS.** Vercel Blob stores are provisioned
#      as either public or private, and the store REJECTS any write whose access
#      does not match. This app writes with `BLOB_ACCESS = "public"`
#      (lib/media/limits.ts) because the catalog renders stored URLs directly
#      with `<Image>` and next.config.ts whitelists
#      `*.public.blob.vercel-storage.com`. A store left on PRIVATE makes every
#      upload fail with HTTP 400 ("Cannot use public access on a private
#      store"). Set it in the dashboard: Storage → the Blob store → Settings →
#      Access / Visibility → Public.
# Do not paste a real token into this file — it is committed; keep it in .env.
# Without the token the admin still loads and image URL fields work, but an
# upload fails with the shared upload error toast. A store/visibility mismatch
# shows a dedicated, actionable message instead (admin.error.storageAccessMismatch).
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# SMS provider seam — lib/auth/sms.ts (sms.ir Verify integration)
# ---------------------------------------------------------------------------
# OTP codes are delivered through sms.ir's Verify API (lib/auth/sms.ts).
# While SMSIR_API_KEY stays unset the development mock ([DEV OTP] ...) is used,
# and production refuses to run without a real key.
#
# To go live with sms.ir:
#   1. Create a Sandbox API key via sms.ir panel:
#      برنامه‌نویسان → لیست کلیدهای API → ایجاد کلید جدید (type: Sandbox)
#      → copy it into SMSIR_API_KEY below (and locally in .env).
#   2. The Sandbox only supports the fixed Verify template "123456" whose text
#      is "کد تایید شما: #CODE#". This is SMSIR_VERIFY_TEMPLATE_ID's default.
#      Before going to production you MUST:
#        a. Create a real production API key (type: Production) and set it as
#           SMSIR_API_KEY.
#        b. Create a real production Verify template in the sms.ir panel and
#           set its ID as SMSIR_VERIFY_TEMPLATE_ID (replace the "123456" default).
#   3. Never commit real values of these variables — keep them out of version
#      control and set them in Vercel / your hosting environment.
SMSIR_API_KEY=""
SMSIR_VERIFY_TEMPLATE_ID="123456"

# ---------------------------------------------------------------------------
# Order receipts — lib/notifications/ (SMS + email after a successful payment)
# ---------------------------------------------------------------------------
# Once a ZarinPal payment verifies, the customer is sent an order receipt from
# the checkout callback route. Channel policy is SMS first, email as fallback
# (see lib/notifications/order-receipt.ts for why).

# Dedicated sms.ir sending line for PLAIN (non-template) messages.
# The order receipt uses POST /v1/send/bulk, which is a DIFFERENT endpoint from
# the OTP /send/verify and REQUIRES a line number. Verify does not need one,
# which is why this is a separate setting.
# Read it from the sms.ir panel (lines / شماره خطوط).
#
# CAUTION: sms.ir publishes a sandbox example ONLY for /send/verify. Their docs
# claim the sandbox mirrors production URL/input/output shapes, but there is no
# bulk sandbox example and no bulk sandbox template, so sandbox delivery for
# this endpoint is UNCONFIRMED. While SMSIR_LINE_NUMBER is unset the receipt is
# written to the server console instead ([DEV SMS] ...), so the flow is testable
# without a line or any gateway egress.
SMSIR_LINE_NUMBER=""

# SMTP — the project's only email path (lib/notifications/email.ts).
# Plain SMTP via nodemailer so any provider works (a free Gmail app-password,
# an Iranian host, or a paid relay) with no vendor lock-in.
# While SMTP_HOST is unset the message is written to the server console
# ([DEV EMAIL] ...); in production an unset SMTP_HOST throws.
SMTP_HOST=""
SMTP_PORT="587"
# Set to "true" for implicit TLS (normally port 465). Leave unset to infer it
# from the port.
SMTP_SECURE=""
SMTP_USER=""
SMTP_PASS=""
# Defaults to SMTP_USER when unset.
SMTP_FROM=""

# ---------------------------------------------------------------------------
# Media storage provider — lib/media/storage/
# ---------------------------------------------------------------------------
# Which StorageProvider the media layer writes through. The registry lives in
# lib/media/storage/index.ts; the values it understands are:
#
#   vercel-blob   (default)  Vercel Blob. Requires BLOB_READ_WRITE_TOKEN above.
#   liara                    Liara Object Storage (S3-compatible). Requires the
#                            four LIARA_* variables below.
#
# LEAVE THIS UNSET ONLY IF YOU WANT VERCEL BLOB. An unset or empty value
# SILENTLY selects `vercel-blob` — no warning, no log — so a deployment that
# configured Liara but forgot this line keeps uploading to Vercel and looks
# like it worked. A value that IS set but unrecognised throws instead.
#
# Confirm what a running process actually resolved:
#   GET /api/admin/media/upload?provider   ->   {"provider":"liara"}
MEDIA_STORAGE_PROVIDER=""

# ---------------------------------------------------------------------------
# Liara Object Storage (S3-compatible) — lib/media/storage/liara.ts
# ---------------------------------------------------------------------------
# Read only when MEDIA_STORAGE_PROVIDER=liara. While that provider is selected,
# the app refuses to BOOT if any of the four is missing (lib/env.ts).
#
# All four come from the Liara console:
#   Object Storage -> your bucket -> Settings -> «دسترسی با SDK»
#
# LIARA_ENDPOINT is a FULL URL INCLUDING THE SCHEME, with no bucket, no port,
# no path and no trailing slash:
#
#   LIARA_ENDPOINT=https://storage.iran.liara.site
#
# The storage cluster answers on `liara.site` (what the console issues) and on
# the `liara.space` alias — both resolve to the same hosts. The corporate
# `liara.ir` domain does NOT resolve for storage, so an endpoint there cannot
# work. Do not put the bucket name in this variable; it has its own below.
#
# The bucket MUST be set to PUBLIC access in the console: the catalogue renders
# the stored URLs directly with <Image>. next.config.ts whitelists the public
# bucket host and must be kept in sync with LIARA_HOST_SUFFIXES in
# lib/media/storage/liara.ts.
#
# SERVER-ONLY. LIARA_SECRET_KEY must never reach the browser — the browser
# receives only a short-lived presigned PUT URL.
LIARA_ENDPOINT=""
LIARA_BUCKET_NAME=""
LIARA_ACCESS_KEY=""
LIARA_SECRET_KEY=""

# ---------------------------------------------------------------------------
# Upload limits — lib/media/limits.ts
# ---------------------------------------------------------------------------
# The image ceiling (5 MB) and the direct-upload threshold (4 MB) are fixed in
# code deliberately. Only the VIDEO ceiling is configurable; its default is
# 200 MB. A malformed value falls back to that default rather than disabling
# the check.
# MEDIA_VIDEO_MAX_BYTES="209715200"